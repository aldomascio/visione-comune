# Application
NEXT_PUBLIC_APP_NAME=Visione Comune
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js
# Generate a real local value with: openssl rand -base64 32
AUTH_SECRET=<replace-with-random-secret>

# Database development
# Copy this value to .env.local and replace placeholders with local credentials.
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/visione_comune_dev

# Database integration tests
# Copy this value to .env.test.local and replace placeholders with local credentials.
TEST_DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/visione_comune_test
