# Application
NEXT_PUBLIC_APP_NAME=Visione Comune
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public contacts (optional bootstrap fallback until values are saved in the admin area)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Public map
# Optional local fallback uses MapLibre demo tiles if this is empty.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Auth.js
# Generate a real local value with: openssl rand -base64 32
AUTH_SECRET=<replace-with-random-secret>

# Database development
# Copy this value to .env.local and replace placeholders with local credentials.
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/visione_comune_dev

# Database integration tests
# Copy this value to .env.test.local and replace placeholders with local credentials.
TEST_DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/visione_comune_test

# Geocoding
# Current MVP adapter uses Photon through server-side API routes.
GEOCODING_PROVIDER=photon
PHOTON_GEOCODING_BASE_URL=https://photon.komoot.io
